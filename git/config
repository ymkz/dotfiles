[user]
  name = ymkz
  email = ymkz@users.noreply.github.com
  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILj8Wt94dRCr9uXjmsw4jvuXo5MdS6UTE+ElkHbYtMP7

[init]
  defaultBranch = main
[core]
  editor = code --wait
  precomposeunicode = true
  ignorecase = false
  quotepath = false
  sshCommand = ssh.exe
[column]
  ui = auto
[status]
  showUntrackedFiles = all
[diff]
  external = difft
[branch]
  sort = -committerdate
[tag]
  sort = version:refname
[push]
  default = simple
  followTags = true
  autoSetupRemote = true
[fetch]
  all = true
  prune = true
  pruneTags = true
[commit]
  verbose = true
  gpgsign = true
[rerere]
  enabled = true
  autoupdate = true
[rebase]
  autoSquash = true
  autoStash = true
  updateRefs = true
[gpg]
  format = ssh
[gpg "ssh"]
  program = op-ssh-sign.exe
  allowedSignersFile = ~/.config/git/signers

[ghq]
  root = ~/work
